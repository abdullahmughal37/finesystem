# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=lms_new

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRE=7d
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# Optional: keep stable after recovery backups exist. Defaults to JWT_SECRET.
RECOVERY_ENCRYPTION_KEY=

# Used only by: npm run seed:admin
ADMIN_NAME=Library Administrator
ADMIN_EMAIL=library.admin@example.edu
ADMIN_PASSWORD=choose-at-least-12-characters

# Email (for nodemailer - Send to Accounts, Reminder Emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@university.edu.pk
SMTP_PASS=your-app-password

# App
NODE_ENV=development
PORT=5000
LIBRARY_TIMEZONE=Asia/Karachi
CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=
